{
	"name": "df_sdc_type1",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_employeesData",
						"type": "DatasetReference"
					},
					"name": "employeesDataFromFile"
				},
				{
					"dataset": {
						"referenceName": "ds_azureSQLDB",
						"type": "DatasetReference"
					},
					"name": "employeesDataFromSQLTable"
				}
			],
			"sinks": [
				{
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "join1"
				},
				{
					"name": "sqlTableHashkey"
				}
			],
			"scriptLines": [
				"source(output(",
				"          {First Name} as string,",
				"          Gender as string,",
				"          {Start Date} as string,",
				"          {Last Login Time} as string,",
				"          Salary as integer,",
				"          {Bonus %} as double,",
				"          {Senior Management} as boolean,",
				"          Team as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> employeesDataFromFile",
				"source(output(",
				"          employee_id as long,",
				"          first_name as string,",
				"          gender as string,",
				"          start_date as string,",
				"          last_login_time as string,",
				"          salary as integer,",
				"          bonus_percentage as decimal(5,3),",
				"          senior_management as string,",
				"          team as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> employeesDataFromSQLTable",
				"employeesDataFromFile derive(hashkey = md5({First Name},Salary,Team)) ~> derivedColumn1",
				"derivedColumn1, sqlTableHashkey join(hashkey == sqlTableHashKey,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"employeesDataFromSQLTable derive(sqlTableHashKey = md5(first_name,salary,team)) ~> sqlTableHashkey",
				"join1 sink(validateSchema: false,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     store: 'cache',",
				"     format: 'inline',",
				"     output: true,",
				"     saveOrder: 1) ~> sink1"
			]
		}
	}
}